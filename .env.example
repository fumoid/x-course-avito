# ---------------------------------------------------------------------------
# Trip Service — переменные окружения.
# Имена зафиксированы курсом: переименовывать нельзя, добавлять свои — можно.
# tripgoctl environment start перезаписывает .env и обычно даёт только DATABASE_URL.
# Остальные значения ниже — дефолты сервиса, дублировать в .env не обязательно.
# ---------------------------------------------------------------------------

# --- ЛР1: сервер и база ----------------------------------------------------
HTTP_ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
HTTP_READ_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s

DATABASE_URL=postgres://tripgo:tripgo@localhost:5432/tripgo?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_QUERY_TIMEOUT=3s

# idempotency key ttl
IDEMPOTENCY_TTL=24h

# --- ЛР2: OpenTelemetry ----------------------------------------------------
# Адрес коллектора пишет tripgoctl environment start в .env.
# Если коллектор недоступен, сервис продолжает отвечать.
OTEL_SERVICE_NAME=trip-service
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_RESOURCE_ATTRIBUTES=service.namespace=tripgo,deployment.environment=local
# otelhttp по умолчанию пишет http.server.duration в мс.
# http/dup включает ещё http.server.request.duration в секундах.
OTEL_SEMCONV_STABILITY_OPT_IN=http/dup
